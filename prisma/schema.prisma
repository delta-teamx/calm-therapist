generator client {
  provider      = "prisma-client-js"
  // native for local dev, rhel for Netlify and other Lambda-style hosts
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  ageGroup           String?
  tone               String    @default("warm")
  focusAreas         String[]
  language           String    @default("en")
  plan               String    @default("free") // "free" | "pro"
  stripeCustomerId   String?   @unique
  isAdmin            Boolean   @default(false)
  // Founding access: member number assigned at signup; the first 150 get full
  // access for four months from foundingUntil computation (see lib/access.ts).
  memberNumber       Int?      @unique
  // First-touch attribution captured at signup (landing path, external referrer).
  signupLanding      String?
  signupReferrer     String?
  // Someone the member would want Aura to name in a hard moment. Stored on the
  // server so it follows them across devices.
  crisisContactName  String?
  crisisContactPhone String?
  // Email preferences
  emailOptOut        Boolean   @default(false)
  unsubscribeToken   String?   @unique
  // Safety: last crisis tier and when it was set (sticky for a window).
  crisisTier         Int       @default(0)
  crisisTierAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Cultural profile
  culturalContext    String?
  familySystem       String?
  countryOfResidence String?
  diasporaStatus     String?
  stigmaContext      String?
  somaticExpression  String?

  // Email verification + password reset (single-use tokens, expiring).
  emailVerified      DateTime?
  verifyToken        String?   @unique
  verifyTokenExpires DateTime?
  resetToken         String?   @unique
  resetTokenExpires  DateTime?

  sessions        Session[]
  memories        Memory[]
  goals           Goal[]
  journalEntries  JournalEntry[]
  subscription    Subscription?
  feedback        Feedback[]
  emailQueue      EmailQueueRow[]
  usageEvents     UsageEvent[]
  voiceQuota      VoiceQuota?
  crisisEvents    CrisisEvent[]
  circleInterests CircleInterest[]
  moodEntries     MoodEntry[]
  supportPasses   SupportPass[]
  unlockCodes     UnlockCode[]
  voiceSessions   VoiceSession[]

  @@index([createdAt])
  @@index([plan])
}

/// One row per safety escalation (tier >= 2). Never deleted; the audit trail.
model CrisisEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tier      Int
  category  String
  source    String // "chat" | "voice" | "feel-it" | "circle"
  country   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Stripe webhook idempotency: an event id is recorded once, inside the same
/// transaction as its side effects.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// A voice session minted server-side. Duration is filled from ElevenLabs,
/// never from the browser.
model VoiceSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?   @unique
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  durationSec    Int?
  source         String    @default("elevenlabs")

  @@index([userId, startedAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  transcript Json
  summary    String?
  moodBefore Int?
  moodAfter  Int?
  // Voice: the ElevenLabs conversation id, so a replayed record is not a second session.
  externalId String?   @unique

  @@index([userId, startedAt])
}

model Memory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement      String
  category       String
  mentions       Int      @default(1)
  firstMentioned DateTime @default(now())
  lastMentioned  DateTime @default(now())

  @@index([userId, mentions])
}

model Goal {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  frequency   String
  createdAt   DateTime         @default(now())
  completions GoalCompletion[]

  @@index([userId])
}

model GoalCompletion {
  id     String   @id @default(cuid())
  goalId String
  goal   Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date   DateTime @default(now())

  @@index([goalId, date])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart  DateTime
  content    String
  aiAnalysis String?
  createdAt  DateTime @default(now())

  @@index([userId, weekStart])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 String // "free" | "pro"
  cadence              String? // "monthly" | "yearly"
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String    @default("active") // "active" | "paused" | "cancelled" | "past_due"
  currentPeriodEnd     DateTime?
  pausedAt             DateTime?
  cancelledAt          DateTime?
  startDate            DateTime  @default(now())
}

model Lead {
  id         String   @id @default(cuid())
  email      String
  source     String
  capturedAt DateTime @default(now())

  @@unique([email, source])
  @@index([capturedAt])
}

model Feedback {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName      String
  userEmail     String
  rating        Int
  comment       String
  publicConsent Boolean   @default(false)
  category      String // "positive" | "neutral" | "needs-attention"
  status        String    @default("new") // "new" | "reviewed" | "responded"
  adminResponse String?
  respondedAt   DateTime?
  // The conversation this was about, when one was recent enough to tell.
  sessionId     String?
  createdAt     DateTime  @default(now())

  @@index([category, createdAt])
  @@index([userId])
}

model VoiceQuota {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey         String
  monthKey        String
  weeklyUsedSec   Int      @default(0)
  monthlyUsedSec  Int      @default(0)
  weeklyBonusSec  Int      @default(0)
  monthlyBonusSec Int      @default(0)
  topupsThisMonth Int      @default(0)
  /// Minutes owned outright, granted by a support pass. Never reset by rollover.
  balanceSec      Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model UsageEvent {
  id               String   @id @default(cuid())
  service          String
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tokensIn         Int?
  tokensOut        Int?
  durationMs       Int?
  estimatedCostUsd Float?
  stance           String?
  ruleViolations   String?
  // Links the turn to its conversation, and keeps enough to recompute cost.
  sessionId        String?
  model            String?
  cacheReadTokens  Int?
  at               DateTime @default(now())

  @@index([at])
  @@index([userId, at])
  @@index([sessionId])
}

model EmailQueueRow {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  to            String
  templateKey   String
  ctxJson       Json
  scheduledAt   DateTime
  status        String    @default("pending") // "pending" | "sending" | "sent" | "failed" | "cancelled"
  sentAt        DateTime?
  error         String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([userId, templateKey])
}

/// A member's answer to "which circles would you join?". Read by the
/// nightly planner once circles open; until then it is the waitlist.
model CircleInterest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     String
  createdAt DateTime @default(now())

  @@unique([userId, theme])
  @@index([theme])
}

/// One tap a day: how the member is arriving. Drives the journal week row
/// and the profile trend; never shown to anyone else.
model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  score     Int
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([userId, day])
}

/// A payment received from Ko-fi. Every webhook is stored exactly once,
/// keyed by Ko-fi's own message id, so a retry is a no-op and an unmatched
/// payment is never lost. `userId` is set when the payment is matched to an
/// account, either by unlock code, by email, or by hand in admin.
model KofiPayment {
  id             String    @id
  transactionId  String?   @unique
  type           String
  amountUsd      Float
  currency       String
  fromName       String?
  email          String?
  message        String?
  claimCode      String?
  isSubscription Boolean   @default(false)
  raw            Json
  receivedAt     DateTime  @default(now())
  userId         String?
  matchedAt      DateTime?
  matchedBy      String?

  @@index([userId])
  @@index([claimCode])
  @@index([email])
  @@index([receivedAt])
}

/// What a supporter unlocked, and until when. Voice minutes are a monthly
/// allowance that resets with the voice quota; circles is a flag.
model SupportPass {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierKey              String
  amountUsd            Float
  currency             String   @default("USD")
  voiceMinutesPerMonth Int
  circles              Boolean  @default(true)
  source               String   @default("kofi")
  kofiPaymentId        String?  @unique
  startedAt            DateTime @default(now())
  expiresAt            DateTime
  note                 String?

  @@index([userId, expiresAt])
}

/// A short code the member puts in their Ko-fi message so the payment can be
/// matched back to their account. Single use, short lived.
model UnlockCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([userId, createdAt])
}
