# OpenAI key. Aura, the onboarding reflection, and the safety second pass all
# run on it. Without it the app streams a mock reply so the UI still works.
OPENAI_API_KEY=

# When DATABASE_URL is set, all persistence (users, feedback, leads,
# voice quotas, email queue, usage events) goes through Prisma + Postgres.
# When unset, the app falls back to in-memory stores so the demo still
# runs — useful for dev, never for production.
#
# After setting this, run:
#   npx prisma migrate dev      # local dev: creates the schema + a migration
#   npx prisma migrate deploy   # production: applies migrations to the live DB
DATABASE_URL=

NEXT_PUBLIC_APP_URL=https://calm-therapist.netlify.app
# Product name shown everywhere. Change this and the URL above to rebrand.
NEXT_PUBLIC_BRAND_NAME=Calm Therapist
NEXT_PUBLIC_BRAND_SHORT=Calm
# Circles open when this many members have joined.
NEXT_PUBLIC_CIRCLES_OPEN_AT=50
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Long random string used to sign session JWTs.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Subdomain that hosts the dashboard. Default "relax" → relax.example.com
DASHBOARD_SUBDOMAIN=relax

# The single email allowed to access /admin.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Google OAuth — if either is missing the "Continue with Google" button
# falls back to a friendly "not configured" message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Otherwise derived from the request host as <origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Lifecycle email (Resend). Without this, sends are logged to the
# server console — handy for dev. With it, real emails go out.
RESEND_API_KEY=
EMAIL_FROM="Aura at Calm Therapist <hello@calmtherapist.implenix.net>"
EMAIL_REPLY_TO=hello@calmtherapist.implenix.net

# Cron secret for the email processor at /api/cron/emails.
# Add to Vercel Cron headers as x-cron-secret.
CRON_SECRET=

# ─── Stripe ─────────────────────────────────────────────────────────────
# When STRIPE_SECRET_KEY is set, /api/billing/* routes use real Stripe
# Checkout. Otherwise the app falls back to the demo upgrade flow that
# just flips the user's plan locally.
#
# 1. Stripe dashboard → Developers → API keys → Secret key
# 2. Create three Products / Prices and copy each price ID:
#    - Pro Monthly  ($19/month, recurring)        → STRIPE_PRICE_MONTHLY
#    - Pro Yearly   ($149/year, recurring)        → STRIPE_PRICE_YEARLY
#    - Voice top-up ($12, one-time)               → STRIPE_PRICE_TOPUP
# 3. Stripe dashboard → Developers → Webhooks → Add endpoint
#    URL:  https://<your-domain>/api/billing/webhook
#    Events: checkout.session.completed,
#            customer.subscription.created,
#            customer.subscription.updated,
#            customer.subscription.deleted,
#            invoice.payment_failed
#    Copy the signing secret → STRIPE_WEBHOOK_SECRET
# 4. Stripe dashboard → Settings → Billing → Customer portal
#    Enable "Cancel" and "Pause" so /api/billing/portal works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_TOPUP=

# ─── Early access and support ────────────────────────────────────────
# The first FOUNDING_MEMBER_CAP members get voice and circles free for
# FOUNDING_MONTHS from their own sign-up, with FOUNDING_VOICE_MINUTES a
# month of voice. Chat is free for everyone, always.
FOUNDING_MEMBER_CAP=150
NEXT_PUBLIC_FOUNDING_CAP=150
FOUNDING_MONTHS=4
FOUNDING_VOICE_MINUTES=60
# Ko-fi "support the creator" link. Unlocks nothing. Leave blank to hide.
NEXT_PUBLIC_KOFI_URL=

# ─── Sessions and safety ──────────────────────────────────────────────
# AUTH_SECRET must be at least 32 characters in production (see above).
# Cookie domain for cross-subdomain sessions, e.g. ".yourdomain.com".
# Leave blank on preview deployments.
COOKIE_DOMAIN=
# Set to 1 only for demos without a database. Never in production.
ALLOW_MEMORY_STORE=
# Development only: shows a hint box on the login page.
NEXT_PUBLIC_DEMO_LOGIN=
# The LLM second pass on the safety classifier is ON by default. Set to
# "off" to disable (not recommended).
CRISIS_LLM_PASS=on
# Model used for Aura's replies and, unless SAFETY_MODEL is set, the safety pass.
AURA_MODEL=gpt-5.4-mini
SAFETY_MODEL=gpt-5.4-mini
# Reasoning effort for the GPT-5 family: minimal, low, medium, high.
AURA_REASONING=low

# ─── ElevenLabs ───────────────────────────────────────────────────────
# Set the agent to PRIVATE in the ElevenLabs dashboard. The app mints a
# signed URL per session on the server; the browser never starts a session
# on its own. Minutes are read back from ElevenLabs after each call.

# ─── Search and analytics ─────────────────────────────────────────────
# Site verification without DNS: paste the token from each console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# IndexNow: any 32-char hex string. After each production build the sitemap
# URLs are submitted to Bing and its partners.
INDEXNOW_KEY=
# Cookieless analytics. Set the domain to turn Plausible on.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
# The named human on the about page and article bylines (E-E-A-T).
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_TITLE=
NEXT_PUBLIC_AUTHOR_URL=
# Clinical reviewer named on the safety and pillar pages (MedicalWebPage reviewedBy).
NEXT_PUBLIC_REVIEWER_NAME=
NEXT_PUBLIC_REVIEWER_TITLE=
# Comma-separated social profile URLs for the Organization schema.
NEXT_PUBLIC_SOCIAL_URLS=
# Date the page copy last changed, for sitemap lastmod.
NEXT_PUBLIC_CONTENT_UPDATED=2026-09-05
